# Copy this file to .env and fill in your values

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/restaurant_pos"

# Secret used to sign login tokens (use a long random string)
JWT_SECRET="change-me-to-a-long-random-string"

# Stripe secret key (get it from your Stripe dashboard)
STRIPE_SECRET_KEY="sk_test_xxx"

# Port the backend runs on
PORT=4000

# Where the frontend runs (for CORS)
FRONTEND_URL="http://localhost:5173"
